{
  "name": "@maxmeis/workflows",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared GitHub workflows and actions",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "test:e2e": "node --test 'actions/*/test/e2e.test.mjs'",
